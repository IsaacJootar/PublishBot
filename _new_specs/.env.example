# PublishAI — API Keys
# Copy this file to .env and fill in your keys
# Never commit the .env file to git

# Required — get yours free at console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — fallback AI if Claude is unavailable
# Get yours at platform.openai.com
OPENAI_API_KEY=

# App settings — do not change
DATABASE_URL=sqlite:///data/publishai.db
DATA_DIR=data
